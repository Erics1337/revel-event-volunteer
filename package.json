{
  "name": "nextjs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:reset": "supabase db reset && npm run db:types",
    "db:migrate:new": "supabase migration new",
    "db:migrate:up": "supabase migration up && npm run db:types",
    "db:push": "supabase db push --linked && npm run db:types",
    "db:reset:prod": "npm run config:push && supabase db reset --linked && npm run db:types",
    "config:push": "set -a && source .env.production && set +a && supabase config push"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@types/papaparse": "^5.5.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "next": "16.2.4",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
